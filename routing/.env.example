# SECURITY NOTE: This is a TEMPLATE file only.
# All values MUST be replaced with actual configuration in your .env file.
# NEVER commit your actual .env file to version control.
# All sensitive values have been REMOVED from this template for security.

# =============================================================================
# WHATSAPP / SEND2.DIGITAL
# =============================================================================
# Required: Webhook verification token for send2.digital
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

# Required: send2.digital API credentials
SEND2_USERNAME=
SEND2_PASSWORD=
SEND2_NUMBER=

# Optional: send2.digital API endpoints (use defaults if not specified)
# SEND2_SESSION_MSG_URL=https://api.send2.digital/devdesk/AI_chatbot_API_incomingentry
# SEND2_LIST_MENU_URL=https://api.send2.digital/whatsapp/attachment/list_messages
# SEND2_QUICK_BUTTON_URL=https://api.send2.digital/whatsapp/attachment/session_msg_quickbtn
# SEND2_MEDIA_URL=https://api.send2.digital/devdesk/media
# SEND2_INCOMING_URL=https://api.send2.digital/devdesk/incoming-report
# SEND2_TEMPLATE_URL=https://api.send2.digital/devdesk/template/create

# =============================================================================
# ADMIN / AUTHENTICATION
# =============================================================================
# SECURITY: Use strong, random secrets (32+ characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
ADMIN_SECRET_KEY=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRY_HOURS=24
ADMIN_TOKEN_TTL_HOURS=168
ADMIN_RECOVERY_KEY=
OTP_EXPIRY_MINUTES=10

# =============================================================================
# PUBLIC URL (must be HTTPS for production)
# =============================================================================
PUBLIC_BASE_URL=

# =============================================================================
# LLM PROVIDER (choose ONE)
# =============================================================================
# Option: ollama / groq / mistral
# For a fully LOCAL bot (no third-party LLM): set API_PROVIDER=ollama,
# set STRICT_LOCAL_LLM=1, and leave GROQ_API_KEY / MISTRAL_API_KEY empty.
API_PROVIDER=ollama

# STRICT_LOCAL_LLM=1 disables all cloud LLM fallbacks (Groq/Mistral).
# The bot will only ever call the local Ollama instance.
STRICT_LOCAL_LLM=1

# Ollama (self-hosted)
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Groq (cloud) - NOT used when STRICT_LOCAL_LLM=1
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# Mistral (cloud) - NOT used when STRICT_LOCAL_LLM=1
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# =============================================================================
# WEBSITE INGESTION (Leeway Softech knowledge base)
# =============================================================================
# Used by: python kb/ingest_website.py
WEBSITE_CRAWL_URL=https://www.leewaysoftech.com
WEBSITE_CRAWL_MAX_PAGES=150
WEBSITE_CRAWL_DELAY=0.5

# =============================================================================
# MEDIA
# =============================================================================
SEND_MEDIA=false
IMAGE_BASE_URL=
IMGBB_API_KEY=

# =============================================================================
# BRAND
# =============================================================================
BRAND_NAME=Leeway Softech
BRAND_TAGLINE=
SUPPORT_EMAIL=
SUPPORT_PHONE=
BRAND_WEBSITE=https://www.leewaysoftech.com
SIGNATURE=

# =============================================================================
# DATABASE
# =============================================================================
ROUTING_DB_PATH=faq.db

# =============================================================================
# EMAIL / SMTP (for OTP delivery)
# =============================================================================
# SECURITY: SMTP credentials should use app-specific passwords, not main account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# =============================================================================
# CORS (comma-separated origins allowed)
# =============================================================================
# Production: Set to your actual domains only
# Development: Can include localhost for testing
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000

# =============================================================================
# ALERT WEBHOOK
# =============================================================================
ALERT_WEBHOOK_URL=

# =============================================================================
# CATALOGUE PDF
# =============================================================================
CATALOGUE_PDF_URL=
CATALOGUE_PDF_FILENAME=

# =============================================================================
# TUNNEL / DEBUG
# =============================================================================
HKDEK_WEBHOOK_URL=
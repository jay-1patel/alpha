@router.get("/menus")
def list_menu_items_api(
    menu_type: str = Query(None),
    section: str = Query(None),
    active_only: bool = Query(True),
    parent_id: int = Query(None),
    action_type: str = Query(None),
    current_admin: dict = Depends(require_permission("view_files")),
):
    """List all menu items with optional filtering."""
    try:
        menus = list_menu_items(
            menu_type=menu_type,
            section=section,
            active_only=active_only,
            parent_id=parent_id,
            action_type=action_type
        )

        # Build tree structure for nested menus
        tree = _build_menu_tree(menus)

        # Group by section for better display
        grouped = {}
        for menu in menus:
            section_name = menu.get("section", "General")
            if section_name not in grouped:
                grouped[section_name] = []
            grouped[section_name].append(menu)

        return {
            "status": "ok",
            "menus": menus,
            "tree": tree,
            "grouped": grouped,
            "total": len(menus)
        }
    except Exception as e:
        logger.error(f"Error listing menu items: {e}")
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/menus")
def create_menu_item_api(
    data: dict,
    current_admin: dict = Depends(require_permission("upload_faq")),
):
    """Create a new dynamic menu item with comprehensive validation."""
    try:
        # Extract and validate required fields
        title = data.get("title", "").strip()
        payload = data.get("payload", "").strip()
        action_type = data.get("action_type", "text").strip().lower()
        action_data = data.get("action_data", "").strip()
        parent_id = data.get("parent_id")
        menu_type = data.get("menu_type", "main").strip()
        section = data.get("section", "General").strip()
        sort_order = data.get("sort_order", 0)

        # Validate required fields
        if not title:
            raise HTTPException(status_code=400, detail="title is required")
        if not payload:
            raise HTTPException(status_code=400, detail="payload is required")

        # Validate title length (WhatsApp limit)
        if len(title) > 24:
            raise HTTPException(status_code=400, detail="title must be 24 characters or less")

        # Validate action_type against allowed types
        from kb.services.dynamic_router import get_allowed_action_types
        allowed_types = get_allowed_action_types()
        if action_type not in allowed_types:
            raise HTTPException(
                status_code=400,
                detail=f"Invalid action_type '{action_type}'. Must be one of: {allowed_types}"
            )

        # Validate action_data based on action_type
        if action_type == "menu":
            # For menu actions, action_data should be a parent_id or "null"/"root"
            if action_data and action_data.lower() not in ["null", "none", "root", ""]:
                try:
                    # Validate it's a valid integer
                    test_parent_id = int(action_data)
                    # Check parent exists
                    parent_check = get_menu_item_by_id(test_parent_id)
                    if not parent_check:
                        raise HTTPException(
                            status_code=400,
                            detail=f"Parent menu item with id {test_parent_id} not found"
                        )
                except ValueError:
                    raise HTTPException(
                        status_code=400,
                        detail="For 'menu' action_type, action_data must be a valid parent_id or 'null'"
                    )
        elif action_type == "rag":
            # For RAG actions, action_data should be a collection name or JSON config
            if not action_data:
                raise HTTPException(
                    status_code=400,
                    detail="action_data is required for 'rag' action_type (collection name or config)"
                )
        elif action_type == "text":
            # For text actions, action_data should be the text to display
            if not action_data:
                raise HTTPException(
                    status_code=400,
                    detail="action_data is required for 'text' action_type (the text to display)"
                )
            # Validate text length (WhatsApp limit)
            if len(action_data) > 4096:
                raise HTTPException(
                    status_code=400,
                    detail=f"action_data too long ({len(action_data)} chars). Max 4096 characters."
                )

        # Validate parent_id if provided separately (for hierarchy)
        if parent_id is not None:
            parent_item = get_menu_item_by_id(parent_id)
            if not parent_item:
                raise HTTPException(
                    status_code=400,
                    detail=f"Parent menu item with id {parent_id} not found"
                )

        # Create the menu item
        menu_id = create_menu_item(
            title=title,
            payload=payload,
            action_type=action_type,
            action_data=action_data,
            parent_id=parent_id,
            menu_type=menu_type,
            section=section,
            sort_order=sort_order
        )

        return {
            "status": "ok",
            "id": menu_id,
            "message": "Dynamic menu item created successfully",
            "warnings": []
        }

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error creating menu item: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"Error creating menu item: {str(e)}")


@router.put("/menus/{payload:path}")
def update_menu_item_api(
    payload: str,
    data: dict,
    current_admin: dict = Depends(require_permission("upload_faq")),
):
    """Update an existing menu item."""
    try:
        allowed_updates = {"title", "action_type", "action_data", "parent_id",
                          "menu_type", "section", "sort_order", "is_active"}
        updates = {k: v for k, v in data.items() if k in allowed_updates}

        if not updates:
            raise HTTPException(status_code=400, detail="No valid fields to update")

        # Validate action_type if being updated
        if "action_type" in updates:
            from kb.services.dynamic_router import get_allowed_action_types
            allowed_types = get_allowed_action_types()
            if updates["action_type"] not in allowed_types:
                raise HTTPException(
                    status_code=400,
                    detail=f"Invalid action_type '{updates['action_type']}'. Must be one of: {allowed_types}"
                )

        # Validate parent_id if being updated
        if "parent_id" in updates and updates["parent_id"] is not None:
            parent_item = get_menu_item_by_id(updates["parent_id"])
            if not parent_item:
                raise HTTPException(
                    status_code=400,
                    detail=f"Parent menu item with id {updates['parent_id']} not found"
                )

        success = update_menu_item(payload, **updates)

        if not success:
            raise HTTPException(status_code=404, detail=f"Menu item with payload '{payload}' not found")

        return {
            "status": "ok",
            "message": "Dynamic menu item updated successfully"
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error updating menu item: {e}")
        raise HTTPException(status_code=500, detail=str(e))


@router.delete("/menus/{payload:path}")
def delete_menu_item_api(
    payload: str,
    current_admin: dict = Depends(require_permission("delete_files")),
):
    """Delete a menu item."""
    try:
        success = delete_menu_item(payload)

        if not success:
            raise HTTPException(status_code=404, detail=f"Menu item with payload '{payload}' not found")

        return {
            "status": "ok",
            "message": "Dynamic menu item deleted successfully"
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error deleting menu item: {e}")
        raise HTTPException(status_code=500, detail=str(e))


def _build_menu_tree(menu_items: list) -> dict:
    """Build hierarchical tree structure from flat menu items."""
    from collections import defaultdict

    # Group by parent_id
    by_parent = defaultdict(list)
    by_id = {}

    for item in menu_items:
        item_id = item.get("id")
        parent_id = item.get("parent_id")

        by_id[item_id] = item
        by_parent[parent_id or None].append(item)

    # Build tree recursively
    def build_node(parent_id=None):
        children = []
        for item in by_parent.get(parent_id, []):
            item_copy = dict(item)
            item_copy["children"] = build_node(item.get("id"))
            children.append(item_copy)
        return children

    return {
        "root": build_node(None),
        "flat": menu_items
    }


# ── Analytics endpoints ───────────────────────────────────────────────────

@router.get("/analytics/response-time")
def get_response_time_analytics(
    days: int = Query(7, ge=1, le=90),

):
    conn = get_db()
    try:
        rows = conn.execute(
            """SELECT DATE(created_at) as date, AVG(response_time_ms) as avg_ms, COUNT(*) as count
               FROM webhook_logs
               WHERE direction = 'outgoing' AND response_time_ms IS NOT NULL
                 AND created_at >= DATE('now', ?)
               GROUP BY DATE(created_at)
               ORDER BY date ASC""",
            (f"-{days} days",),
        ).fetchall()
        return {
            "days": days,
            "data": [
                {
                    "date": r["date"],
                    "avg_ms": round(r["avg_ms"], 1) if r["avg_ms"] else 0,
                    "count": r["count"],
                }
                for r in rows
            ],
        }
    finally:
        conn.close()


@router.get("/analytics/frequent-questions")
def get_frequent_questions(
    days: int = Query(7, ge=1, le=90),
    limit: int = Query(20, ge=1, le=100),

):
    conn = get_db()
    try:
        rows = conn.execute(
            """SELECT message, COUNT(*) as count, MAX(created_at) as last_asked
               FROM chat_history
               WHERE created_at >= DATE('now', ?)
               GROUP BY LOWER(message)
               ORDER BY count DESC, last_asked DESC
               LIMIT ?""",
            (f"-{days} days", limit),
        ).fetchall()
        return {
            "days": days,
            "total_unique": len(rows),
            "questions": [
                {
                    "query": r["message"],
                    "count": r["count"],
                    "last_asked": r["last_asked"],
                }
                for r in rows
            ],
        }
    finally:
        conn.close()


@router.get("/analytics/overview")
def get_analytics_overview(
    days: int = Query(7, ge=1, le=90),

):
    conn = get_db()
    try:
        total_messages = conn.execute(
            """SELECT COUNT(*) as cnt FROM chat_history
               WHERE created_at >= DATE('now', ?)""",
            (f"-{days} days",),
        ).fetchone()["cnt"]

        unique_users = conn.execute(
            """SELECT COUNT(DISTINCT wa_id) as cnt FROM chat_history
               WHERE created_at >= DATE('now', ?)""",
            (f"-{days} days",),
        ).fetchone()["cnt"]

        avg_response = conn.execute(
            """SELECT AVG(response_time_ms) as avg_ms FROM webhook_logs
               WHERE direction = 'outgoing' AND response_time_ms IS NOT NULL
                 AND created_at >= DATE('now', ?)""",
            (f"-{days} days",),
        ).fetchone()["avg_ms"]

        route_breakdown = conn.execute(
            """SELECT route, COUNT(*) as count FROM chat_history
               WHERE created_at >= DATE('now', ?)
               GROUP BY route""",
            (f"-{days} days",),
        ).fetchall()

        return {
            "days": days,
            "total_messages": total_messages,
            "unique_users": unique_users,
            "avg_response_ms": round(avg_response, 1) if avg_response else 0,
            "route_breakdown": [dict(r) for r in route_breakdown],
        }
    finally:
        conn.close()


# ── Top questions ─────────────────────────────────────────────────────────

@router.get("/analytics/top-questions")
def get_top_questions(
    days: int = Query(7, ge=1, le=90),
    limit: int = Query(10, ge=1, le=50),

):
    conn = get_db()
    try:
        rows = conn.execute(
            """SELECT message, COUNT(*) as count
               FROM chat_history
               WHERE created_at >= DATE('now', ?)
               GROUP BY LOWER(message)
               ORDER BY count DESC
               LIMIT ?""",
            (f"-{days} days", limit),

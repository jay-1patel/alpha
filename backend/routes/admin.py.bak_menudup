</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📱 WhatsApp Menu Manager</h1>
            <p>Manage your dynamic WhatsApp bot menus - no code deployment needed!</p>
        </div>

        <!-- Form Section -->
        <div class="form-section">
            <h2 class="section-title">Add New Menu Item</h2>

            <div id="message-container"></div>

            <form id="menu-form">
                <div class="form-group">
                    <label for="title">Button Text *</label>
                    <input type="text" id="title" name="title" required maxlength="24" placeholder="e.g., 'View Products'">
                    <div class="hint">Max 24 characters - this is what users will see on WhatsApp</div>
                </div>

                <div class="form-group">
                    <label for="payload">Payload ID *</label>
                    <input type="text" id="payload" name="payload" required placeholder="e.g., 'menu_001'">
                    <div class="hint">Unique identifier for this menu item (e.g., menu_001, action_products)</div>
                </div>

                <div class="form-group">
                    <label for="action_type">Action Type *</label>
                    <select id="action_type" name="action_type" required>
                        <option value="">Select action type...</option>
                        <option value="text">text - Display static message</option>
                        <option value="rag">rag - Search knowledge base</option>
                        <option value="menu">menu - Show sub-menu options</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="action_data">Action Data *</label>
                    <textarea id="action_data" name="action_data" required placeholder="Enter action data..."></textarea>
                    <div class="hint" id="action_data_hint">Select an action type to see hint</div>
                </div>

                <div class="form-group">
                    <label for="parent_id">Parent Menu (Optional)</label>
                    <select id="parent_id" name="parent_id">
                        <option value="">None - Root level menu</option>
                    </select>
                    <div class="hint">Select a parent menu to create nested sub-menus</div>
                </div>

                <div class="form-group">
                    <label for="section">Section (Optional)</label>
                    <input type="text" id="section" name="section" placeholder="e.g., 'Products'">
                    <div class="hint">Group related menu items together</div>
                </div>

                <div class="form-group">
                    <label for="sort_order">Sort Order</label>
                    <input type="number" id="sort_order" name="sort_order" value="0" min="0">
                    <div class="hint">Lower numbers appear first</div>
                </div>

                <button type="submit" class="btn btn-primary">Add Menu Item</button>
            </form>
        </div>

        <!-- Table Section -->
        <div class="table-section">
            <h2 class="section-title">Existing Menu Items</h2>

            <div id="table-loading" class="loading">Loading menu items...</div>
            <div id="table-container"></div>
        </div>
    </div>

    <script>
        // API Configuration
        const API_BASE = '/api/admin';
        const CSRF_TOKEN = getCsrfToken();

        function getCsrfToken() {
            // Try to get CSRF token from meta tag or cookie
            const metaTag = document.querySelector('meta[name="csrf-token"]');
            if (metaTag) return metaTag.getAttribute('content');

            // Fallback to cookie
            const match = document.cookie.match(/csrf_token=([^;]+)/);
            return match ? match[1] : '';
        }

        // Action type hints
        const ACTION_HINTS = {
            text: 'Enter the message text to display to users (max 4096 characters)',
            rag: 'Enter the collection name to search in the knowledge base (e.g., "faq", "kb") or JSON config like {"collection": "faq", "query": "shipping"}',
            menu: 'Enter the parent ID for sub-menu or leave empty for root menu. Can also be JSON like {"parent_id": 5}'
        };

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadMenuItems();
            loadParentMenus();
            setupActionTypeListener();
            setupFormSubmit();
        });

        // Setup action type change listener
        function setupActionTypeListener() {
            const actionTypeSelect = document.getElementById('action_type');
            const actionDataHint = document.getElementById('action_data_hint');

            actionTypeSelect.addEventListener('change', function() {
                const selectedType = this.value;
                if (ACTION_HINTS[selectedType]) {
                    actionDataHint.textContent = ACTION_HINTS[selectedType];
                } else {
                    actionDataHint.textContent = 'Select an action type to see hint';
                }

                // Update placeholder
                const actionDataTextarea = document.getElementById('action_data');
                switch(selectedType) {
                    case 'text':
                        actionDataTextarea.placeholder = 'Enter your message here...';
                        break;
                    case 'rag':
                        actionDataTextarea.placeholder = 'faq';
                        break;
                    case 'menu':
                        actionDataTextarea.placeholder = 'Enter parent ID or leave empty for root menu';
                        break;
                    default:
                        actionDataTextarea.placeholder = 'Enter action data...';
                }
            });
        }

        // Setup form submission
        function setupFormSubmit() {
            document.getElementById('menu-form').addEventListener('submit', async function(e) {
                e.preventDefault();

                const formData = {
                    title: document.getElementById('title').value.trim(),
                    payload: document.getElementById('payload').value.trim(),
                    action_type: document.getElementById('action_type').value,
                    action_data: document.getElementById('action_data').value.trim(),
                    parent_id: document.getElementById('parent_id').value || null,
                    section: document.getElementById('section').value.trim() || null,
                    sort_order: parseInt(document.getElementById('sort_order').value) || 0
                };

                // Convert parent_id to null if empty
                if (formData.parent_id === '') {
                    formData.parent_id = null;
                } else {
                    formData.parent_id = parseInt(formData.parent_id);
                }

                try {
                    showMessage('Creating menu item...', 'info');

                    const response = await fetch(`${API_BASE}/menus`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (response.ok) {
                        showMessage('Menu item created successfully!', 'success');
                        document.getElementById('menu-form').reset();
                        loadMenuItems(); // Refresh table
                        loadParentMenus(); // Refresh parent dropdown
                    } else {
                        showMessage(`Error: ${result.detail || 'Failed to create menu item'}`, 'error');
                    }

                } catch (error) {
                    showMessage(`Network error: ${error.message}`, 'error');
                }
            });
        }

        // Load menu items
        async function loadMenuItems() {
            const tableContainer = document.getElementById('table-container');
            const loadingDiv = document.getElementById('table-loading');

            try {
                const response = await fetch(`${API_BASE}/menus`);
                const result = await response.json();

                loadingDiv.style.display = 'none';

                if (!result.menus || result.menus.length === 0) {
                    tableContainer.innerHTML = '<div class="empty-state">No menu items found. Add your first menu item above!</div>';
                    return;
                }

                const tableHTML = createMenuTable(result.menus);
                tableContainer.innerHTML = tableHTML;

                // Setup delete buttons
                setupDeleteButtons();

            } catch (error) {
                loadingDiv.style.display = 'none';
                tableContainer.innerHTML = `<div class="error">Error loading menu items: ${error.message}</div>`;
            }
        }

        // Create menu table HTML
        function createMenuTable(menuItems) {
            let html = `
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Payload</th>
                            <th>Action Type</th>
                            <th>Action Data</th>
                            <th>Parent ID</th>
                            <th>Section</th>
                            <th>Active</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            menuItems.forEach(item => {
                const badgeClass = `badge-${item.action_type}`;
                const displayActionData = truncateText(item.action_data, 50);
                const isInactive = !item.is_active;

                html += `
                    <tr style="${isInactive ? 'opacity: 0.6;' : ''}">
                        <td>${item.id}</td>
                        <td>${escapeHtml(item.title)}</td>
                        <td><code>${escapeHtml(item.payload)}</code></td>
                        <td><span class="badge ${badgeClass}">${item.action_type}</span></td>
                        <td title="${escapeHtml(item.action_data)}">${escapeHtml(displayActionData)}</td>
                        <td>${item.parent_id || '-'}</td>
                        <td>${escapeHtml(item.section || '-')}</td>
                        <td>${item.is_active ? '✓' : '✗'}</td>
                        <td>
                            <button class="btn btn-danger delete-btn" data-payload="${escapeHtml(item.payload)}">
                                Delete
                            </button>
                        </td>
                    </tr>
                `;
            });

            html += `
                    </tbody>
                </table>
            `;

            return html;
        }

        // Load parent menus for dropdown
        async function loadParentMenus() {
            const parentSelect = document.getElementById('parent_id');

            try {
                const response = await fetch(`${API_BASE}/menus`);
                const result = await response.json();

                // Keep the "None" option and add root menus
                const currentSelection = parentSelect.value;
                parentSelect.innerHTML = '<option value="">None - Root level menu</option>';

                if (result.menus && result.menus.length > 0) {
                    const rootMenus = result.menus.filter(item => !item.parent_id);

                    rootMenus.forEach(item => {
                        const option = document.createElement('option');
                        option.value = item.id;
                        option.textContent = `${item.title} (${item.payload})`;
                        if (item.id === parseInt(currentSelection)) {
                            option.selected = true;
                        }
                        parentSelect.appendChild(option);
                    });
                }

            } catch (error) {
                console.error('Error loading parent menus:', error);
            }
        }

        // Setup delete button handlers
        function setupDeleteButtons() {
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', async function() {
                    const payload = this.getAttribute('data-payload');

                    if (!confirm(`Are you sure you want to delete menu item: ${payload}?`)) {
                        return;
                    }

                    try {
                        showMessage('Deleting menu item...', 'info');

                        const response = await fetch(`${API_BASE}/menus/${encodeURIComponent(payload)}`, {
                            method: 'DELETE'
                        });

                        if (response.ok) {
                            showMessage('Menu item deleted successfully!', 'success');
                            loadMenuItems(); // Refresh table
                            loadParentMenus(); // Refresh parent dropdown
                        } else {
                            const result = await response.json();
                            showMessage(`Error: ${result.detail || 'Failed to delete menu item'}`, 'error');
                        }

                    } catch (error) {
                        showMessage(`Network error: ${error.message}`, 'error');
                    }
                });
            });
        }

        // Show message to user
        function showMessage(message, type = 'info') {
            const container = document.getElementById('message-container');

            const messageDiv = document.createElement('div');
            messageDiv.className = type === 'error' ? 'error' : (type === 'success' ? 'success' : 'loading');
            messageDiv.textContent = message;

            container.innerHTML = '';
            container.appendChild(messageDiv);

            // Auto-hide success messages after 5 seconds
            if (type === 'success') {
                setTimeout(() => {
                    messageDiv.style.display = 'none';
                }, 5000);
            }
        }

        // Utility functions
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function truncateText(text, maxLength) {
            if (!text) return '';
            if (text.length <= maxLength) return text;
            return text.substring(0, maxLength) + '...';
        }
    </script>
</body>
</html>
"""


# ── Menu Manager Admin Interface ─────────────────────────────────────────────

@router.get("/menu-manager")
async def menu_manager_page():
    """Serve the admin panel for managing dynamic menus - accessible at /api/admin/menu-manager (NO AUTH for testing)"""
    return HTMLResponse(content=MENU_MANAGER_HTML)


@router.get("/menu-manager-secure")
async def menu_manager_page_secure(current_admin: dict = Depends(get_current_admin)):
    """Serve the admin panel for managing dynamic menus - REQUIRES AUTHENTICATION - accessible at /api/admin/menu-manager-secure"""
    return HTMLResponse(content=MENU_MANAGER_HTML)
